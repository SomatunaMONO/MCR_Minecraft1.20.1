import { Button, VerticalBox, HorizontalBox, ListView, LineEdit, TextEdit, ScrollView, CheckBox } from "std-widgets.slint";

export struct LauncherPath {
    path: string
}

export struct Hostname {
    name: string
}

export enum AppView {
    main,
    settings,
    logs
}

export component AppWindow inherits Window {
    title: "Minecraft ランチャー with Cloudflared";
    preferred-width: 800px;
    preferred-height: 600px;

    // Properties
    in-out property <[LauncherPath]> launcher-paths: [];
    in-out property <[Hostname]> hostnames: [];
    in-out property <string> local-addr: "127.0.0.1:20100";
    in-out property <int> selected-launcher-index: 0;
    in-out property <int> selected-hostname-index: 0;
    in-out property <string> status-message: "準備完了";
    in-out property <bool> is-running: false;
    in-out property <string> log-output: "";
    in-out property <bool> command-only: false;
    in-out property <AppView> current-view: AppView.main;

    // Callbacks
    callback add-launcher-path(string);
    callback remove-launcher-path(int);
    callback add-hostname(string);
    callback remove-hostname(int);
    callback update-local-addr(string);
    callback save-config();
    callback load-config();
    callback start-launcher();
    callback stop-processes();
    callback append-log(string);
    callback toggle-command-only(bool);

    VerticalBox {
        // Navigation
        HorizontalBox {
            padding: 8px;
            spacing: 8px;
            Button {
                text: "メイン";
                clicked => { root.current-view = AppView.main; }
            }
            Button {
                text: "設定";
                clicked => { root.current-view = AppView.settings; }
            }
            Button {
                text: "ログ";
                clicked => { root.current-view = AppView.logs; }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: #ddd;
            height: 1px;
        }

        // Main content
        if root.current-view == AppView.main: VerticalBox {
            padding: 16px;
            spacing: 12px;

            // Status section
            Rectangle {
                background: #2c3e50;
                border-radius: 8px;
                height: 56px;
                border-width: 2px;
                border-color: root.is-running ? #4CAF50 : #f44336;

                HorizontalBox {
                    padding: 10px;
                    spacing: 12px;
                    alignment: space-between;

                    Text {
                        text: "ステータス: " + root.status-message;
                        font-size: 15px;
                        font-weight: 600;
                        color: #ffffff;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        background: root.is-running ? #4CAF50 : #f44336;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                    }
                }
            }

            HorizontalBox {
                spacing: 16px;

                left-panel := VerticalBox {
                    spacing: 12px;

                    // Launcher selection
                    Rectangle {
                        background: #1f2a39;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #2f3b4d;

                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 8px;
                                Text {
                                    text: "Minecraftランチャー";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: #e2e9f5;
                                }
                                if root.launcher-paths.length > 0: Text {
                                    text: " (" + (root.selected-launcher-index + 1) + "/" + root.launcher-paths.length + ")";
                                    font-size: 12px;
                                    color: #9db3cf;
                                }
                            }

                            if root.launcher-paths.length > 0: Rectangle {
                                height: 150px;
                                border-width: 1px;
                                border-color: #2c3a4d;
                                border-radius: 6px;

                                ScrollView {
                                    VerticalBox {
                                        padding: 6px;
                                        spacing: 6px;

                                        for launcher-path[i] in root.launcher-paths: Rectangle {
                                            background: root.selected-launcher-index == i ? #2a3d54 : #1a2230;
                                            border-width: 1px;
                                            border-color: root.selected-launcher-index == i ? #4da3ff : #2d3a4a;
                                            border-radius: 6px;
                                            height: 32px;

                                            HorizontalBox {
                                                padding: 8px;
                                                spacing: 8px;
                                                Rectangle {
                                                    background: root.selected-launcher-index == i ? #4da3ff : #32445a;
                                                    width: 10px;
                                                    height: 10px;
                                                    border-radius: 5px;
                                                }
                                                Text {
                                                    text: launcher-path.path;
                                                    font-size: 13px;
                                                    vertical-alignment: center;
                                                    font-weight: root.selected-launcher-index == i ? 600 : 400;
                                                    color: root.selected-launcher-index == i ? #b5dcff : #d5deeb;
                                                    wrap: no-wrap;
                                                }
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.selected-launcher-index = i;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.launcher-paths.length == 0: Text {
                                text: "ランチャーパスが設定されていません。設定タブで追加してください。";
                                font-size: 13px;
                                color: #ff9585;
                            }
                        }
                    }

                    // Hostname selection
                    Rectangle {
                        background: #1f2a39;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #2f3b4d;

                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalBox {
                                spacing: 8px;
                                Text {
                                    text: "ホスト名";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: #e2e9f5;
                                }
                                if root.hostnames.length > 0: Text {
                                    text: " (" + (root.selected-hostname-index + 1) + "/" + root.hostnames.length + ")";
                                    font-size: 12px;
                                    color: #9db3cf;
                                }
                            }

                            if root.hostnames.length > 0: Rectangle {
                                height: 150px;
                                border-width: 1px;
                                border-color: #2c3a4d;
                                border-radius: 6px;

                                ScrollView {
                                    VerticalBox {
                                        padding: 6px;
                                        spacing: 6px;

                                        for hostname[i] in root.hostnames: Rectangle {
                                            background: root.selected-hostname-index == i ? #264434 : #1a2230;
                                            border-width: 1px;
                                            border-color: root.selected-hostname-index == i ? #4CAF50 : #2d3a4a;
                                            border-radius: 6px;
                                            height: 32px;

                                            HorizontalBox {
                                                padding: 8px;
                                                spacing: 8px;
                                                Rectangle {
                                                    background: root.selected-hostname-index == i ? #4CAF50 : #32445a;
                                                    width: 10px;
                                                    height: 10px;
                                                    border-radius: 5px;
                                                }
                                                Text {
                                                    text: hostname.name;
                                                    font-size: 13px;
                                                    vertical-alignment: center;
                                                    font-weight: root.selected-hostname-index == i ? 600 : 400;
                                                    color: root.selected-hostname-index == i ? #b2f2c0 : #d5deeb;
                                                    wrap: no-wrap;
                                                }
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.selected-hostname-index = i;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.hostnames.length == 0: Text {
                                text: "ホスト名が設定されていません。設定タブで追加してください。";
                                font-size: 13px;
                                color: #ff9585;
                            }
                        }
                    }
                }

                right-panel := VerticalBox {
                    spacing: 12px;

                    if (root.command-only && root.hostnames.length > 0) || (!root.command-only && root.launcher-paths.length > 0 && root.hostnames.length > 0): Rectangle {
                        background: #2e3b4e;
                        border-width: 2px;
                        border-color: #4da3ff;
                        border-radius: 12px;
                        height: 160px;

                        VerticalBox {
                            padding: 18px;
                            spacing: 10px;
                            Text {
                                text: "現在の設定";
                                font-size: 18px;
                                font-weight: 700;
                                color: #ecf0f1;
                            }
                            if !root.command-only: Text {
                                text: "ランチャー: " + root.launcher-paths[root.selected-launcher-index].path;
                                font-size: 14px;
                                color: #d5dde5;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "ホスト名: " + root.hostnames[root.selected-hostname-index].name;
                                font-size: 14px;
                                color: #d5dde5;
                            }
                            Text {
                                text: "ローカルアドレス: " + root.local-addr;
                                font-size: 14px;
                                color: #d5dde5;
                            }
                            Text {
                                text: "モード: " + (root.command-only ? "コマンドのみ" : "ランチャー + コマンド");
                                font-size: 14px;
                                color: #d5dde5;
                            }
                        }
                    }

                    VerticalBox {
                        spacing: 8px;
                        Text {
                            text: "クラウド接続操作";
                            font-size: 15px;
                            font-weight: 600;
                            color: #e2e9f5;
                        }

                        CheckBox {
                            text: "コマンドのみ実行（ランチャーを起動しない）";
                            checked: root.command-only;
                            toggled => {
                                root.command-only = self.checked;
                                root.toggle-command-only(self.checked);
                            }
                        }

                        HorizontalBox {
                            spacing: 12px;
                            Button {
                                text: root.is-running ? "停止" : "開始";
                                primary: true;
                                enabled: (root.command-only && root.hostnames.length > 0) || (!root.command-only && root.launcher-paths.length > 0 && root.hostnames.length > 0);
                                clicked => {
                                    if root.is-running {
                                        root.stop-processes();
                                    } else {
                                        root.start-launcher();
                                    }
                                }
                            }
                            Button {
                                text: "設定読み込み";
                                clicked => {
                                    root.load-config();
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #1a2433;
                        border-width: 1px;
                        border-color: #2d394b;
                        border-radius: 10px;

                        VerticalBox {
                            padding: 12px;
                            Text {
                                text: root.command-only ? 
                                    (root.hostnames.length == 0 ? "ホスト名を設定タブで追加してください。" : "開始ボタンでcloudflaredのみを起動します。") :
                                    (root.launcher-paths.length == 0 || root.hostnames.length == 0 ? "ランチャーとホスト名を設定タブで追加してください。" : "開始ボタンでランチャーとcloudflaredを起動します。");
                                font-size: 13px;
                                color: #c4d0e2;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        if root.current-view == AppView.settings: ScrollView {
            VerticalBox {
                padding: 16px;
                spacing: 16px;

                // Launcher paths section
                Rectangle {
                    background: #1f2a39;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2f3b4d;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "Minecraftランチャーの登録";
                            font-size: 18px;
                            font-weight: 700;
                            color: #e2e9f5;
                        }
                        Text {
                            text: "Cloudflared 起動時に利用する Minecraft ランチャーのパスを登録します。";
                            font-size: 13px;
                            color: #9db3cf;
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            spacing: 10px;
                            launcher-path-input := LineEdit {
                                placeholder-text: "ランチャーパスまたはURLを入力...";
                                font-size: 14px;
                                preferred-width: 360px;
                            }
                            Button {
                                text: "追加";
                                width: 80px;
                                clicked => {
                                    if launcher-path-input.text != "" {
                                        root.add-launcher-path(launcher-path-input.text);
                                        launcher-path-input.text = "";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 160px;
                            border-width: 1px;
                            border-color: #2c3a4d;
                            border-radius: 8px;

                            ScrollView {
                                VerticalBox {
                                    padding: 8px;
                                    spacing: 8px;

                                    if root.launcher-paths.length == 0: Text {
                                        text: "登録済みのランチャーがありません。追加してください。";
                                        font-size: 13px;
                                        color: #9db3cf;
                                    }

                                    for launcher-path[i] in root.launcher-paths: Rectangle {
                                        background: #1a2230;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #2d3a4a;
                                        height: 44px;

                                        HorizontalBox {
                                            padding: 8px;
                                            spacing: 12px;
                                            alignment: space-between;
                                            Text {
                                                text: launcher-path.path;
                                                font-size: 13px;
                                                color: #d5deeb;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                            }
                                            Button {
                                                text: "削除";
                                                width: 72px;
                                                clicked => {
                                                    root.remove-launcher-path(i);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Hostnames section
                Rectangle {
                    background: #1f2a39;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2f3b4d;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "ホスト名の登録";
                            font-size: 18px;
                            font-weight: 700;
                            color: #e2e9f5;
                        }
                        Text {
                            text: "Cloudflared で公開するホスト名を登録します。";
                            font-size: 13px;
                            color: #9db3cf;
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            spacing: 10px;
                            hostname-input := LineEdit {
                                placeholder-text: "ホスト名を入力...";
                                font-size: 14px;
                                preferred-width: 360px;
                            }
                            Button {
                                text: "追加";
                                width: 80px;
                                clicked => {
                                    if hostname-input.text != "" {
                                        root.add-hostname(hostname-input.text);
                                        hostname-input.text = "";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 160px;
                            border-width: 1px;
                            border-color: #2c3a4d;
                            border-radius: 8px;

                            ScrollView {
                                VerticalBox {
                                    padding: 8px;
                                    spacing: 8px;

                                    if root.hostnames.length == 0: Text {
                                        text: "登録済みのホスト名がありません。追加してください。";
                                        font-size: 13px;
                                        color: #9db3cf;
                                    }

                                    for hostname[i] in root.hostnames: Rectangle {
                                        background: #1a2230;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #2d3a4a;
                                        height: 44px;

                                        HorizontalBox {
                                            padding: 8px;
                                            spacing: 12px;
                                            alignment: space-between;
                                            Text {
                                                text: hostname.name;
                                                font-size: 13px;
                                                color: #d5deeb;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                            }
                                            Button {
                                                text: "削除";
                                                width: 72px;
                                                clicked => {
                                                    root.remove-hostname(i);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Network and save section
                Rectangle {
                    background: #1f2a39;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #2f3b4d;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "接続設定";
                            font-size: 18px;
                            font-weight: 700;
                            color: #e2e9f5;
                        }
                        Text {
                            text: "ローカルアドレスは Cloudflared がトンネルする先の Minecraft サーバーです。";
                            font-size: 13px;
                            color: #9db3cf;
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            spacing: 10px;
                            local-addr-input := LineEdit {
                                text: root.local-addr;
                                placeholder-text: "127.0.0.1:20100";
                                font-size: 14px;
                                preferred-width: 240px;
                            }
                            Button {
                                text: "更新";
                                width: 80px;
                                clicked => {
                                    root.update-local-addr(local-addr-input.text);
                                }
                            }
                        }

                        Rectangle {
                            background: #1a2230;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #2d3a4a;

                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                Text {
                                    text: "現在の設定内容";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: #e0e7f3;
                                }
                                Text {
                                    text: "ランチャー数: " + root.launcher-paths.length;
                                    font-size: 13px;
                                    color: #d5deeb;
                                }
                                Text {
                                    text: "ホスト名数: " + root.hostnames.length;
                                    font-size: 13px;
                                    color: #d5deeb;
                                }
                                Text {
                                    text: "ローカルアドレス: " + root.local-addr;
                                    font-size: 13px;
                                    color: #d5deeb;
                                }
                            }
                        }

                        Button {
                            text: "設定を保存";
                            primary: true;
                            clicked => {
                                root.save-config();
                            }
                        }
                    }
                }
            }
        }

        if root.current-view == AppView.logs: VerticalBox {
            padding: 16px;
            spacing: 12px;

            Text {
                text: "アプリケーションログ";
                font-size: 18px;
                font-weight: 700;
                color: #e2e9f5;
            }

            Rectangle {
                background: #101820;
                border-radius: 8px;
                border-width: 1px;
                border-color: #2c3e50;
                height: 360px;
                VerticalBox {
                    padding: 12px;
                    ScrollView {
                        VerticalBox {
                            Text {
                                text: root.log-output == "" ? "ログはまだありません。" : root.log-output;
                                color: #e0e0e0;
                                font-size: 13px;
                                font-family: "Consolas";
                                wrap: word-wrap;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                alignment: end;
                Button {
                    text: "ログをクリア";
                    clicked => {
                        root.log-output = "";
                    }
                }
            }
        }
    }
}
